CONFIGSENTINEL_DEBUG=true
CONFIGSENTINEL_PRODUCT_NAME=Assurance Workspace
CONFIGSENTINEL_SECRET_KEY=development-only-change-me
CONFIGSENTINEL_ALLOWED_HOSTS=localhost,127.0.0.1
CONFIGSENTINEL_CSRF_TRUSTED_ORIGINS=http://localhost:8000
CONFIGSENTINEL_DATABASE_URL=sqlite:///db.sqlite3
CONFIGSENTINEL_SECURE_SSL_REDIRECT=false
CONFIGSENTINEL_POSTGRES_PASSWORD=local-development-only
CONFIGSENTINEL_DB_OWNER_PASSWORD=change-owner-password
CONFIGSENTINEL_DB_RUNTIME_PASSWORD=change-runtime-password
CONFIGSENTINEL_DOMAIN=localhost
CONFIGSENTINEL_TOTP_ISSUER=Assurance Workspace
# Generate once: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CONFIGSENTINEL_EVIDENCE_MASTER_KEY=
CONFIGSENTINEL_EVIDENCE_STORAGE_ROOT=evidence_objects
CONFIGSENTINEL_EVIDENCE_MAX_UPLOAD_BYTES=26214400
# Gemini is disabled by default. A key alone must never activate outbound AI.
GEMINI_ENABLED=false
# Gemini key is local only. Never commit a populated .env file.
GEMINI_API_KEY=

